<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Updates: hands a downloaded release APK to the package installer.
         Full edition only: Play updates the Play edition. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The ads and billing plugins are linked into both editions, but only
         the Play edition uses them. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="com.android.vending.BILLING"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_TOPICS"
        tools:node="remove" />
    <application>
        <!-- Nor does the ads SDK start with the app. -->
        <provider
            android:name="com.google.android.gms.ads.MobileAdsInitProvider"
            android:authorities="${applicationId}.mobileadsinitprovider"
            tools:node="remove" />
        <activity android:name=".LinkActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="safebooru.org" />
                <data android:host="danbooru.donmai.us" />
                <data android:host="safebooru.donmai.us" />
                <data android:host="konachan.com" />
                <data android:host="konachan.net" />
                <data android:host="yande.re" />
                <data android:host="e926.net" />
                <data android:host="e621.net" />
                <data android:host="gelbooru.com" />
                <data android:host="rule34.xxx" />
                <data android:host="chan.sankakucomplex.com" />
                <data android:host="sankaku.app" />
                <data android:host="www.sankaku.app" />
                <data android:host="idol.sankakucomplex.com" />
                <data android:host="idolcomplex.com" />
                <data android:host="www.idolcomplex.com" />
                <data android:host="tbib.org" />
                <data android:host="nozomi.la" />
                <data android:host="sakugabooru.com" />
                <data android:host="www.sakugabooru.com" />
                <data android:host="xbooru.com" />
                <data android:host="mspabooru.com" />
                <data android:host="e-shuushuu.net" />
                <data android:host="booru.funmaker.moe" />
                <data android:host="realbooru.com" />
                <data android:host="derpibooru.org" />
                <data android:host="trixiebooru.org" />
            </intent-filter>
            <!-- Hosts that also serve pages other than the booru: posts only. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="www.sankakucomplex.com" />
                <data android:host="sankakucomplex.com" />
                <data android:host="emmytherobot.art" />
                <data android:pathPrefix="/posts/" />
                <data android:pathPrefix="/post/show/" />
                <data android:pathPrefix="/post/view/" />
                <data android:pathPrefix="/post/list/" />
                <!-- Sankaku links often start with a language, as in /en/posts/. -->
                <data android:pathPattern="/.*/posts/.*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
